{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "entreid-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Development/app",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "entreid-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Development/api",
        "run",
        "start:dev"
      ],
      "port": 4000,
      "autoPort": false
    }
  ]
}
