# /srv/parakarsa/Development/api/.env — produksi
NODE_ENV=production
PORT=4000

# Satu domain untuk web dan API; ini juga satu-satunya origin CORS yang diizinkan.
APP_URL=https://parakarsa.id

# --- e.id OAuth SSO (host terpisah dari Issuer/Verifier) ---
EID_BASE_URL=https://api-wallet.e.id
EID_CLIENT_ID=
EID_CLIENT_SECRET=
# Harus SAMA PERSIS dengan yang didaftarkan di dashboard e.id.
EID_CALLBACK_URL=https://parakarsa.id/api/v1/callback/e-id
EID_SCHEMA_PRIVATE_CODE=

# --- e.id Verifier (login QR) ---
EID_VERIFIER_BASE_URL=https://gateway.e.id
EID_VERIFIER_CLIENT_ID=
EID_VERIFIER_CLIENT_SECRET=
EID_VERIFIER_SCHEMA_ID=
EID_VERIFIER_CALLBACK_URL=https://parakarsa.id/api/v1/callback/e-id
# WAJIB begitu tiga EID_VERIFIER_* di atas diisi. Tanpa rahasia ini, siapa pun
# bisa memalsukan callback dan menerbitkan akun; API menolak menyala tanpa itu.
#   openssl rand -hex 32
EID_VERIFIER_CALLBACK_SECRET=

# --- Penyimpanan ---
DATABASE_FILE=/srv/parakarsa/Development/api/data/parakarsa.db
# Pepper untuk sidik jari NIK. Acak, rahasia, WAJIB di produksi (>= 32 karakter),
# dan JANGAN pernah diganti setelah ada akun: mengganti pepper membuat semua akun
# lama tidak dikenali lagi.   openssl rand -hex 32
NIK_PEPPER=
# Kunci induk envelope encryption. API menolak menyala di produksi tanpa ini.
# Kehilangan kunci ini berarti kehilangan nama, email, dan telepon seluruh akun.
#   openssl rand -base64 32
PARAKARSA_MASTER_KEY=
