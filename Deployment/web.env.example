# /srv/parakarsa/Development/app/.env.production
# Ditanam saat build, jadi ubah dulu baru jalankan deploy.sh.
# Sama domain dengan web -> cookie sesi same-origin, tanpa CORS.
NEXT_PUBLIC_API_URL=https://parakarsa.id

# Diisi bila explorer IDChain sudah punya alamat publik; kosong = UI menawarkan
# salin hash, bukan tautan mati.
NEXT_PUBLIC_IDCHAIN_EXPLORER=
