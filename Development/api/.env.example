# e.id OAuth SSO — the SSO service has its OWN host, separate from the Issuer
# API (gateway-sandbox.e.id / gateway.e.id). Using the Issuer host here makes
# every SSO call return a bare nginx 403.
#   Sandbox    https://api-dev.e.id
#   Production https://api-wallet.e.id
EID_BASE_URL=https://api-dev.e.id
EID_CLIENT_ID=
EID_CLIENT_SECRET=
# Must match EXACTLY the callback URL registered on the e.id OAuth app.
EID_CALLBACK_URL=http://localhost:4000/api/v1/callback/e-id
# Shared secret bound to your document schema; guards the verify endpoint.
EID_SCHEMA_PRIVATE_CODE=

# Where to send the browser after login, and the only allowed CORS origin.
APP_URL=http://localhost:3000
PORT=4000

# e.id Verifier API (PRD 3.2) — login QR. Host-nya sama dengan Issuer API,
# BUKAN host OAuth SSO. Sandbox https://gateway-sandbox.e.id
# Kredensial verifier diberikan support@corp.e.id setelah onboarding.
# Tanpa ketiganya, alur QR berjalan dalam mode simulasi.
EID_VERIFIER_BASE_URL=https://gateway-sandbox.e.id
EID_VERIFIER_CLIENT_ID=
EID_VERIFIER_CLIENT_SECRET=
EID_VERIFIER_SCHEMA_ID=
# Harus terjangkau dari internet (HTTPS) saat sudah di VPS.
EID_VERIFIER_CALLBACK_URL=http://localhost:4000/api/v1/callback/e-id
# Rahasia bersama untuk memastikan callback benar-benar dari e.id.
EID_VERIFIER_CALLBACK_SECRET=
