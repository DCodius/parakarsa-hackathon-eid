# e.id OAuth SSO — sandbox
EID_BASE_URL=https://gateway-sandbox.e.id
EID_CLIENT_ID=
EID_CLIENT_SECRET=
# Must match EXACTLY the callback URL registered on the e.id OAuth app.
EID_CALLBACK_URL=http://localhost:4000/api/v1/callback/e-id
# Shared secret bound to your document schema; guards the verify endpoint.
EID_SCHEMA_PRIVATE_CODE=

# Where to send the browser after login, and the only allowed CORS origin.
APP_URL=http://localhost:3000
PORT=4000
