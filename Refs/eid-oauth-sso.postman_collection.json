{
  "info": {
    "name": "EID OAuth SSO API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "This is a REST API use for interact with backend service provider\n\n---\n\n**How to use this collection**\n\n1. Fill the collection variables: `oauth_base_url`, `oauth_client_id`, `oauth_client_secret`.\n2. Call **Get Access Token** (Authentication folder) and copy `data.token` from the response.\n3. Paste it into the `oauth_access_token` variable — every request sends it automatically as a Bearer token.\n\nEach request includes saved example responses (success and error cases). Values like `example-...` and all-zero UUIDs are placeholders — replace them with your own data."
  },
  "item": [
    {
      "name": "OAuth",
      "description": "OAuth 2.0 SSO flow, in call order: fetch app info, verify the client, exchange the authorization code for a token, then read the user profile.",
      "item": [
        {
          "name": "Verify Client ID and Callback URL",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Browser entry point of the SSO flow: redirect the user's browser here. e.id validates the `client_id` and `callback_url`, then responds with a **302 redirect** — to the e.id login page when the client is valid, or to the unauthorized-client page when it is not.",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{oauth_base_url}}/api/v1.1/oauth/verify",
              "host": [
                "{{oauth_base_url}}"
              ],
              "path": [
                "api",
                "v1.1",
                "oauth",
                "verify"
              ],
              "query": [
                {
                  "key": "client_id",
                  "value": "example-client-id",
                  "description": "Unique application ID registered in the OAuth system.",
                  "disabled": true
                },
                {
                  "key": "callback_url",
                  "value": "https://your-app.com/callback",
                  "description": "Callback URL that will be used after authentication.",
                  "disabled": true
                }
              ]
            }
          },
          "response": [
            {
              "name": "302 Found",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "description": "Browser entry point of the SSO flow: redirect the user's browser here. e.id validates the `client_id` and `callback_url`, then responds with a **302 redirect** — to the e.id login page when the client is valid, or to the unauthorized-client page when it is not.",
                "auth": {
                  "type": "noauth"
                },
                "url": {
                  "raw": "{{oauth_base_url}}/api/v1.1/oauth/verify",
                  "host": [
                    "{{oauth_base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1.1",
                    "oauth",
                    "verify"
                  ],
                  "query": [
                    {
                      "key": "client_id",
                      "value": "example-client-id",
                      "description": "Unique application ID registered in the OAuth system.",
                      "disabled": true
                    },
                    {
                      "key": "callback_url",
                      "value": "https://your-app.com/callback",
                      "description": "Callback URL that will be used after authentication.",
                      "disabled": true
                    }
                  ]
                }
              },
              "status": "Found",
              "code": 302,
              "_postman_previewlanguage": "text",
              "header": [],
              "cookie": [],
              "body": ""
            }
          ]
        },
        {
          "name": "Get OAuth Token",
          "request": {
            "method": "POST",
            "header": [],
            "description": "This endpoint is used to obtain an OAuth token after the authorization process is successful. The client must send client_id, client_secret, code, and redirect_uri.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{oauth_client_id}}\",\n  \"client_secret\": \"{{oauth_client_secret}}\",\n  \"code\": \"example-authorization-code\",\n  \"redirect_uri\": \"https://e.id/callback\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{oauth_base_url}}/api/v1.1/oauth/get-token",
              "host": [
                "{{oauth_base_url}}"
              ],
              "path": [
                "api",
                "v1.1",
                "oauth",
                "get-token"
