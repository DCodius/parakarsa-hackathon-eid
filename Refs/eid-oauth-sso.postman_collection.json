              "path": [
                "api",
                "v1.1",
                "oauth",
                "get-profile"
              ],
              "query": [
                {
                  "key": "scope",
                  "value": "email:profile",
                  "description": "The scope that determines the returned profile data (e.g., email:profile).",
                  "disabled": true
                }
              ]
            }
          },
